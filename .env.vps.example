# Copy to .env.vps and fill real values:
#   cp .env.vps.example .env.vps
#
# Used by: docker compose --env-file .env.vps up -d

NODE_ENV=production

# Public site URLs (CORS + absolute links)
FRONTEND_ORIGINS=https://riobizsols.com,https://www.riobizsols.com
CHATBOT_PUBLIC_BASE_URL=https://riobizsols.com
PUBLIC_BASE_URL=https://riobizsols.com

# Gmail SMTP (chat / general alerts — unchanged)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Zoho SMTP for landing forms only (pricing / demo / /eam-production)
LANDING_EMAIL_USER=info@riobizsols.com
LANDING_EMAIL_PASS=your-zoho-password
LANDING_EMAIL_HOST=smtp.zoho.in
LANDING_EMAIL_PORT=587

CHAT_NOTIFICATION_EMAIL=tony.rozario@riobizsols.com
CHAT_NOTIFICATION_FROM=
DEMO_BOOKING_NOTIFICATION_EMAILS=tony.rozario@riobizsols.com,shilpa@riobizsols.com
CALENDLY_API_TOKEN=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_CLICK_PHONE=918884910777
WHATSAPP_CLICK_MESSAGE=Hi RIO BizSols, I am interested in CMMS Software. Please contact me.
WHATSAPP_CLICK_EMAIL_NOTIFY=false
WHATSAPP_TEMPLATE_BODY_PARAM_MODE=
WHATSAPP_VERIFY_TOKEN=

# Admin chat
ADMIN_CHAT_TOKEN=change-me-to-a-long-random-string

# Optional PDF URLs
CHATBOT_PDF_URL_ALM=
CHATBOT_PDF_URL_ASSIST=
CHATBOT_PDF_URL_MEMS=
CHATBOT_SERVICES_PDF_URL=
