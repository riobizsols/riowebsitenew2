# Server port (use 3004 if 3003 is already in use)
PORT=3004

# Production mode (set for deployment)
NODE_ENV=production
# Allowed frontend origins for CORS (comma-separated). Example:
# FRONTEND_ORIGINS=https://riobizsols.com,https://www.riobizsols.com
FRONTEND_ORIGINS=

# Gmail SMTP for contact form (use App Password, not account password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# Optional: inbox for website chat notifications (defaults to info@riobizsols.com)
CHAT_NOTIFICATION_EMAIL=info@riobizsols.com
# Optional: full From header for floating-chat notifications. If blank, uses: bizsolsrio@gmail.com
# Example: CHAT_NOTIFICATION_FROM=Rio Website <bizsolsrio@gmail.com>
CHAT_NOTIFICATION_FROM=
# Demo booking notification recipients (comma-separated)
DEMO_BOOKING_NOTIFICATION_EMAILS=tony.rozario@riobizsols.com,shilpa@riobizsols.com

# WhatsApp Cloud API (Meta template send setup)
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_TO_NUMBER=91xxxxxxxxxx
WHATSAPP_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_TEMPLATE_LANG=en_US
# Set to 'single' only if template body has exactly one placeholder (e.g. {{1}})
WHATSAPP_TEMPLATE_BODY_PARAM_MODE=

# Chatbot PDF download URLs (optional but recommended for production)
# If not set, backend auto-builds links using CHATBOT_PUBLIC_BASE_URL + /pdfs/*.pdf
CHATBOT_PUBLIC_BASE_URL=
CHATBOT_PDF_URL_ALM=
CHATBOT_PDF_URL_ASSIST=
CHATBOT_PDF_URL_MEMS=
CHATBOT_SERVICES_PDF_URL=

# Webhook verification — must match Meta Developer Console → WhatsApp → Configuration → Webhook verify token
# Callback URL (HTTPS): https://YOUR-DOMAIN/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=WhatsAppWebhookadmin@2026

# Admin support inbox (/admin/chat) — required in production to protect chat list & admin replies
# Use a long random string. Send as: Authorization: Bearer <token> from the admin UI after sign-in.
ADMIN_CHAT_TOKEN=RIOvps@2025*
